# BASE Apptainer image for GRAFT on NAISS Arrhenius GPU nodes (GH200, Arm/aarch64): everything except flash-attn.
# Built by naiss/build_container.sbatch (stage 1) ON A GPU NODE (the login node is x86).
# Same package versions as rl/uv.lock (SU HPC x86 setup), except:
#   - torch/torchvision/torchaudio come from the PyTorch cu128 index (PyPI's aarch64 torch is CPU-only),
#   - flash-attn 2.8.3 has no aarch64 wheel (its setup.py download gave HTTP 404), so it is compiled
#     separately (stage 2) and added in naiss/graft_arm_final.def (stage 3),
#   - flash-attn-3 is skipped (train.py only uses flash_attention_2).
Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

%files
    rl/pyproject.toml /opt/graft/pyproject.toml
    rl/uv.lock /opt/graft/uv.lock

%environment
    export PATH=/opt/venv/bin:$PATH
    export VIRTUAL_ENV=/opt/venv
    export LC_ALL=C.UTF-8

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends git curl ca-certificates build-essential ninja-build libsndfile1
    rm -rf /var/lib/apt/lists/*

    # uv + Python 3.11 in world-readable locations (not /root)
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_CACHE_DIR=/tmp/uvcache UV_LINK_MODE=copy
    uv venv /opt/venv --python 3.11
    export VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH

    # 1. CUDA PyTorch for aarch64
    uv pip install torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
        --index-url https://download.pytorch.org/whl/cu128

    # 2. All other packages at the exact uv.lock versions (fully resolved list -> --no-deps)
    cd /opt/graft
    uv export --frozen --no-hashes --no-dev --no-emit-project --format requirements-txt -o /tmp/req.txt
    grep -vE '^(torch|torchvision|torchaudio|flash-attn|flash-attn-3)([ =@;]|$)' /tmp/req.txt > /tmp/req-arm.txt
    uv pip install --no-deps -r /tmp/req-arm.txt

    # 3. Build tools for compiling flash-attn later (stage 2 runs `python -m pip wheel` in this image)
    uv pip install pip setuptools wheel packaging psutil ninja

    # 4. soundfile (imported by transformers.audio_utils -> needed by TRL's GRPOTrainer) opens
    #    'libsndfile.so'; the Ubuntu runtime package only ships libsndfile.so.1 -> add the plain name.
    #    The aarch64 soundfile wheel does not bundle the library (the x86 one does).
    ln -sf "$(ls /usr/lib/*-linux-gnu/libsndfile.so.1 | head -1)" /usr/lib/$(uname -m)-linux-gnu/libsndfile.so
    ldconfig
    python -c "import soundfile, transformers.audio_utils; print('soundfile OK, libsndfile', soundfile.__libsndfile_version__)"
    python -c "from trl import GRPOTrainer; print('trl GRPOTrainer import OK')"

    rm -rf /tmp/uvcache /tmp/req.txt /tmp/req-arm.txt
